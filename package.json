{
  "name": "@_nazmiforreal/infected",
  "version": "1.0.1",
  "description": "A unified MCP server for modular operations.",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "bin": {
    "infected": "./index.js"
  },
  "scripts": {
    "start": "mkdir -p logs && npx kill-port 3001 || true && INFECTED_RUNTIME_MODE=development LOG_LEVEL=debug nohup tsx src/index.ts > logs/start.log 2>&1 &",
    "dev": "mkdir -p logs && INFECTED_RUNTIME_MODE=development LOG_LEVEL=debug NODE_OPTIONS='--enable-source-maps' tsx watch --clear-screen=false src/index.ts | stdbuf -o L tee logs/dev.log",
    "build:server": "tsc",
    "build:tools": "tsc --project tsconfig.tools.json",
    "build": "npm run build:server && npm run build:tools",
    "pack": "npm run build && npm pack",
    "publish:npm": "npm run pack && npm publish --access public",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "files": [
    "dist",
    "tools",
    "plugins",
    "docs",
    "infected.config.json",
    "infected.config.json.example",
    ".env.example",
    "index.js"
  ],
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/chokidar": "^2.1.7",
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.11.5",
    "@types/turndown": "^5.0.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "inquirer": "^9.2.16",
    "@modelcontextprotocol/inspector": "^0.21.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "axios": "^1.6.8",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0-rc.12",
    "chokidar": "^5.0.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "minimatch": "^10.2.2",
    "node-pty": "^1.1.0",
    "robots-parser": "^2.1.0",
    "turndown": "^7.1.3",
    "uuid": "^13.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  }
}
