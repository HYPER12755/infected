{
  "name": "@infected/infected",
  "version": "1.0.0",
  "description": "A unified MCP server for modular operations.",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "bin": {
    "infected": "./dist/index.js"
  },
  "scripts": {
    "start": "mkdir -p logs && nohup tsx src/index.ts > logs/start.log 2>&1 &",
    "dev": "mkdir -p logs && LOG_LEVEL=debug nohup tsx watch src/index.ts > logs/dev.log 2>&1 &",
    "build": "tsc && echo '#!/usr/bin/env node\\n' | cat - dist/index.js > /tmp/infected-temp && mv /tmp/infected-temp dist/index.js && chmod +x dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/express": "^4.17.21",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.11.5",
    "@types/turndown": "^5.0.4",
    "inquirer": "^9.2.16",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "axios": "^1.6.8",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "minimatch": "^10.2.2",
    "node-pty": "^1.1.0",
    "robots-parser": "^2.1.0",
    "turndown": "^7.1.3",
    "uuid": "^13.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  }
}
